# Copy this file to .env and fill actual values.
# Never commit .env with real secrets.
# LIVEKIT_* are required for voice and screen share.

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_MAX_PARTICIPANTS=5
LIVEKIT_TOKEN_TTL=6h
PORT=3000

# Set this to the Render service URL when deploying the frontend separately.
VITE_SOCKET_URL=

# Optional comma-separated frontend origins for Socket.IO (including custom domains).
CORS_ORIGINS=
